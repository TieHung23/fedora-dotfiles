// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "base_keymap": "Zed",
  // C#: OmniSharp language server, pulled from the extension registry.
  "auto_install_extensions": {
    "csharp": true
  },
  // C# debugging. The "netcoredbg" adapter itself comes from the dev extension
  // installed by fedora-dotfiles/install-zed-csharp.sh — this block only points
  // it at the system netcoredbg instead of letting it download an older one.
  // Real path, not the /usr/local/bin symlink: netcoredbg loads managed DLLs
  // from beside its own binary.
  "dap": {
    "netcoredbg": {
      "binary": "/usr/local/lib/netcoredbg/netcoredbg"
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Ayu Dark",
  },
}
